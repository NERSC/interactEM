{
  "name": "@interactem/interactem",
  "version": "0.0.4",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/interactem.umd.cjs",
  "module": "./dist/interactem.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/interactem.js",
      "require": "./dist/interactem.umd.cjs"
    },
    "./style.css": "./dist/interactem.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc && vite build --config vite.config.ts && tsc -p tsconfig.lib.json",
    "build:app": "tsc && vite build --config vite.config.app.ts",
    "build": "npm run build:lib && npm run build:app",
    "lint": "npx biome check --write .",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "deduplicate-enums": "tsx scripts/deduplicate-enums.ts src/types/gen.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^6.0.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.26.0",
    "@nats-io/jetstream": "^3.3.0",
    "@nats-io/kv": "^3.3.0",
    "@nats-io/nats-core": "^3.3.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.4",
    "date-fns": "^4.1.0",
    "react-hook-form": "^7.71.1",
    "react-infinite-scroll-component": "^6.1.1",
    "react-toastify": "^11.0.3",
    "react-virtuoso": "^4.18.1",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^3.25.76"
  },
  "license": "LBNL BSD-3",
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@hey-api/openapi-ts": "^0.90.10",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "path": "^0.12.7",
    "playwright": "^1.58.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-morph": "^27.0.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  }
}
