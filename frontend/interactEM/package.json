{
  "name": "@interactem/interactem",
  "version": "0.0.4",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/interactem.umd.cjs",
  "module": "./dist/interactem.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/interactem.js",
      "require": "./dist/interactem.umd.cjs"
    },
    "./style.css": "./dist/interactem.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc && vite build --config vite.config.ts && tsc -p tsconfig.lib.json",
    "build:app": "tsc && vite build --config vite.config.app.ts",
    "build": "npm run build:lib && npm run build:app",
    "lint": "npx biome check --write .",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "deduplicate-enums": "tsx scripts/deduplicate-enums.ts src/types/gen.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^7.0.5",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "react-hook-form": "^7.91.0",
    "react-infinite-scroll-component": "^6.1.1",
    "react-toastify": "^11.2.0",
    "react-virtuoso": "^4.18.1",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^3.25.76"
  },
  "license": "LBNL BSD-3",
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "json-schema-to-typescript": "~15.0.4",
    "path": "^0.12.7",
    "playwright": "^1.58.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  }
}
